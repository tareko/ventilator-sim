 "ards_mod": {
  "title": "Moderate ARDS",
  "adapt_hours": 0.0,
  "story": "The classic ARDS trade-off case: dependent lung is collapsed, the non-dependent lung is already near its limit. PEEP is a negotiation between oxygenation, stress and cardiac output.",
  "try": [
   "abg",
   "optimize",
   "run 10m",
   "set peep=20",
   "run 10m",
   "trend"
  ],
  "expect": "Recruitment climbs with PEEP while shunt falls, but local stress and dead space rise and cardiac output drops. Somewhere in the middle driving pressure is lowest - that is the honest optimum.",
